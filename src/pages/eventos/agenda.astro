---
import ListingLayout from '@/layouts/ListingLayout.astro';
import { CalendarIcon, MapPinIcon, SparkleIcon } from '@/components/ui/icons';
import JsonLd from '@/components/seo/JsonLd.astro';
import { AgendaItem } from '@/components/content/AgendaItem';
import { getUpcomingAgenda } from '@/lib/content';
import { toAgendaItem } from '@/lib/cards';
import { eventSchema } from '@/lib/seo';

// Gerada no build: eventos passados somem no build diário (ver .github/workflows/deploy.yml)
const entries = await getUpcomingAgenda();
const items = entries.map(toAgendaItem);
const schemas = entries.map((e) =>
  eventSchema({
    name: e.data.title,
    description: e.data.description,
    path: '/eventos/agenda',
    date: e.data.date,
    time: e.data.time,
    endTime: e.data.endTime,
    location: e.data.location,
    address: e.data.address,
    city: e.data.city,
    registrationUrl: e.data.url,
  }),
);
---

<ListingLayout
  icon={CalendarIcon}
  accents={[MapPinIcon, SparkleIcon]}
  title="Agenda"
  seoTitle="Agenda de eventos em Franca e região"
  eyebrow="O que vem por aí"
  description="Próximos eventos, encontros e experiências em Franca e região, com inscrições e link para salvar na sua agenda."
  crumbs={[
    { label: 'Início', href: '/' },
    { label: 'Eventos', href: '/eventos' },
    { label: 'Agenda', href: '/eventos/agenda' },
  ]}
  isEmpty={items.length === 0}
  emptyMessage="Nenhum evento agendado no momento. Tem um evento para divulgar? Fale com a Lú."
>
  {schemas.length > 0 && <JsonLd data={schemas} />}
  <ul class="grid gap-4">
    {items.map((item) => (
      <li>
        <AgendaItem item={item} />
      </li>
    ))}
  </ul>
</ListingLayout>
