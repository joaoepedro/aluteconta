---
import { Image } from 'astro:assets';
import logo from '@/assets/logo-a-lu-te-conta.png';
import { MAIN_NAV, isActive } from '@/lib/navigation';
import { SITE } from '@/lib/site';
import MobileMenu from './MobileMenu.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="border-borda bg-branco sticky top-0 z-40 border-b">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
    <a
      href="/"
      class="flex items-center gap-3 no-underline"
      aria-label={`${SITE.name}, página inicial`}
    >
      <Image src={logo} alt="" width={44} height={44} loading="eager" class="size-11" />
      <span class="font-display text-azul hidden text-lg font-bold whitespace-nowrap sm:block">
        {SITE.name}
      </span>
    </a>

    <nav aria-label="Menu principal" class="hidden lg:block">
      <ul class="flex items-center gap-1 xl:gap-2">
        {MAIN_NAV.map((item) => {
          const active = isActive(currentPath, item.href);
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'font-display rounded-full px-3 py-2 text-sm font-semibold whitespace-nowrap no-underline xl:px-4',
                  item.highlight
                    ? 'bg-laranja text-noite hover:brightness-95'
                    : 'text-azul hover:bg-creme',
                  active && !item.highlight && 'bg-creme',
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <MobileMenu items={MAIN_NAV} currentPath={currentPath} />
  </div>
</header>
