---
/**
 * Cabeçalho estilo portal de notícias:
 * linha 1 → menu (☰) | logo centralizado | botão de orçamento
 * linha 2 → barra de seções (no celular desliza para o lado)
 */
import { Image } from 'astro:assets';
import logo from '@/assets/logo-a-lu-te-conta.png';
import { HEADER_CTA, MAIN_NAV, activeHref } from '@/lib/navigation';
import { SITE } from '@/lib/site';
import MobileMenu from './MobileMenu.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = activeHref(currentPath);
---

<header class="border-borda bg-branco sticky top-0 z-40 border-b [view-transition-name:cabecalho]">
  <div class="mx-auto grid h-14 max-w-7xl grid-cols-[auto_1fr_auto] items-center gap-2 px-4 sm:h-16 sm:grid-cols-[1fr_auto_1fr] sm:gap-3 sm:px-6">
    <!-- coluna da esquerda: o ☰ só aparece abaixo de 1024 px (no desktop a barra mostra tudo) -->
    <div>
      <MobileMenu items={MAIN_NAV} cta={HEADER_CTA} active={active} />
    </div>

    <a
      href="/"
      class="flex items-center gap-2 no-underline sm:gap-2.5"
      aria-label={`${SITE.name}, página inicial`}
    >
      <Image
        src={logo}
        alt=""
        width={44}
        height={44}
        densities={[1, 2, 3]}
        quality={90}
        loading="eager"
        class="size-10 sm:size-11"
      />
      <span class="font-display text-azul hidden text-base font-bold whitespace-nowrap min-[380px]:block sm:text-xl">
        {SITE.name}
      </span>
    </a>

    <div class="flex justify-end">
      <a
        href={HEADER_CTA.href}
        class="bg-laranja text-noite font-display rounded-full px-3.5 py-2 text-sm font-bold sm:px-4 whitespace-nowrap no-underline hover:brightness-95"
      >
        {HEADER_CTA.label}
      </a>
    </div>
  </div>

  <nav aria-label="Seções do site" class="border-borda border-t">
    <ul
      data-fade-scroll
      class="no-scrollbar fade-end mx-auto flex h-11 max-w-7xl items-center gap-6 overflow-x-auto px-4 sm:px-6 lg:justify-center lg:gap-9 lg:[mask-image:none]"
    >
      {MAIN_NAV.map((item) => {
        const isCurrent = active === item.href;
        return (
          <li class="h-full shrink-0">
            <a
              href={item.href}
              data-astro-prefetch="tap"
              aria-current={isCurrent ? 'page' : undefined}
              class:list={[
                'font-display flex h-full items-center border-b-[3px] text-[0.95rem] font-semibold whitespace-nowrap no-underline transition-colors',
                isCurrent ? 'border-laranja' : 'hover:border-borda border-transparent',
                item.highlight || isCurrent ? 'text-laranja-texto' : 'text-azul',
              ]}
            >
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
    <script is:inline>
      // Barra de seções no celular: mantém a posição de rolagem ao trocar de página
      // e garante que a seção atual fique visível (roda antes de a página aparecer).
      (() => {
        const ul = document.currentScript.previousElementSibling;
        const key = 'barra-secoes';
        try {
          const saved = sessionStorage.getItem(key);
          if (saved !== null) ul.scrollLeft = Number(saved);
          sessionStorage.removeItem(key);
        } catch {
          /* navegação privada sem armazenamento: segue sem lembrar a posição */
        }
        const atual = ul.querySelector('[aria-current="page"]');
        if (atual) {
          const a = atual.getBoundingClientRect();
          const u = ul.getBoundingClientRect();
          if (a.left < u.left || a.right > u.right - 48) {
            ul.scrollLeft += a.left - u.left - (u.width - a.width) / 2;
          }
        }
        ul.addEventListener('click', (e) => {
          if (!e.target.closest('a')) return;
          try {
            sessionStorage.setItem(key, String(ul.scrollLeft));
          } catch {
            /* navegação privada sem armazenamento: segue sem lembrar a posição */
          }
        });
      })();
    </script>
  </nav>
</header>

<script>
  // Listas que deslizam de lado (barra de seções, filtros): o esmaecido da direita
  // só aparece quando ainda há itens escondidos; no fim da lista, some.
  const listas = document.querySelectorAll<HTMLElement>('[data-fade-scroll]');
  for (const lista of listas) {
    const atualizar = () => {
      const fim = lista.scrollLeft + lista.clientWidth >= lista.scrollWidth - 4;
      lista.classList.toggle('fade-end', !fim);
    };
    atualizar();
    lista.addEventListener('scroll', atualizar, { passive: true });
    addEventListener('resize', atualizar);
  }
</script>
